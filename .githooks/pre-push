#!/bin/sh
# pre-push: block the push unless total Go test coverage is at least MIN percent.
# Bypass in a genuine emergency with: git push --no-verify
MIN=70.0

echo "pre-push: checking test coverage (minimum ${MIN}%)..."
prof="$(mktemp)" || exit 1
if ! go test -coverpkg=./... -coverprofile="$prof" ./... >/tmp/turnvpn-cov.log 2>&1; then
	echo "pre-push: BLOCKED — tests failed:" >&2
	tail -n 40 /tmp/turnvpn-cov.log >&2
	rm -f "$prof"
	exit 1
fi
total="$(go tool cover -func="$prof" | awk '/^total:/ {gsub(/%/,"",$3); print $3}')"
rm -f "$prof"

if [ -z "$total" ]; then
	echo "pre-push: BLOCKED — could not compute coverage" >&2
	exit 1
fi
echo "pre-push: total coverage ${total}%"
if awk -v t="$total" -v m="$MIN" 'BEGIN { exit !(t+0 >= m+0) }'; then
	echo "pre-push: coverage OK (>= ${MIN}%)"
	exit 0
fi
echo "pre-push: BLOCKED — coverage ${total}% is below the required ${MIN}%." >&2
echo "pre-push: add tests to raise it, or bypass once with: git push --no-verify" >&2
exit 1
